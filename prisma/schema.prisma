generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipTier {
  ROAD
  TOURING
  COMPETITION
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELED
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  passwordHash            String
  firstName               String
  lastName                String
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  profile                 MemberProfile?
  memberships             Membership[]
  vehicles                Vehicle[]
  notificationPreference  NotificationPreference?
  favoriteEvents          FavoriteEvent[]
  activities              Activity[]

  @@index([createdAt])
}

model MemberProfile {
  userId    String  @id
  phone     String?
  city      String?
  state     String?
  avatarUrl String?
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Membership {
  id          String           @id @default(cuid())
  userId      String
  tier        MembershipTier
  status      MembershipStatus @default(ACTIVE)
  startDate   DateTime
  renewalDate DateTime
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([renewalDate])
}

model Vehicle {
  id         String   @id @default(cuid())
  userId     String
  year       Int
  make       String
  model      String
  nickname   String?
  vin        String?  @unique
  imageUrl   String?
  isFavorite Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([make, model])
}

model NotificationPreference {
  userId            String  @id
  emailEnabled      Boolean @default(true)
  smsEnabled        Boolean @default(false)
  eventReminders    Boolean @default(true)
  marketingEnabled Boolean @default(false)
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Event {
  id          String          @id @default(cuid())
  name        String
  description String
  location    String
  startDate   DateTime
  endDate     DateTime
  imageUrl    String?
  favorites   FavoriteEvent[]

  @@index([startDate])
  @@index([location])
}

model FavoriteEvent {
  userId    String
  eventId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([userId, eventId])
  @@index([eventId])
}

model Activity {
  id        String   @id @default(cuid())
  userId    String
  type      String
  summary   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
